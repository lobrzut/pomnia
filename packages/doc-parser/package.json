{
  "name": "@pomnia/doc-parser",
  "version": "0.1.0",
  "private": true,
  "description": "Local document parsing for Pomnia — PDF/DOCX to markdown without Java/Python.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "mammoth": "^1.12.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
