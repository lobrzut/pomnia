; SPDX-License-Identifier: AGPL-3.0-only
; Pomnia brain-core — MCP + RAG over a vault, on Linux.
;
; Install with deploy/install.sh, which creates the user and the directories
; this unit assumes. Edit ExecStart to match your paths, then:
;   systemctl daemon-reload && systemctl enable --now pomnia-brain-core

[Unit]
Description=Pomnia brain-core — MCP memory server (vault + RAG)
Documentation=https://pomnia.ai
; Embeddings default to in-process ONNX (BRAIN_EMBED_BACKEND=fastembed).
; No ordering on Ollama — KVM search does not need it. Distillation stays on
; GPU machines. If you point BRAIN_EMBED_BACKEND=ollama instead, a late Ollama
; means /healthz says degraded until it appears; refusing to start would turn
; a partial outage into a full one.
Wants=network-online.target
After=network-online.target
; install.sh appends RequiresMountsFor= when --vault-root is outside data-dir.
RequiresMountsFor=/var/lib/pomnia

[Service]
Type=simple
; Not root. The process parses network input — JSON bodies and base64 file
; uploads from /sync — and nothing it does needs privilege.
User=pomnia
Group=pomnia
WorkingDirectory=/opt/pomnia-brain-core

; KVM product default: ONNX nomic embed (~0.5 GB), no chat model, no Ollama.
Environment=BRAIN_EMBED_BACKEND=fastembed
Environment=BRAIN_EMBED_CACHE=/var/lib/pomnia/embed-cache

; This host is the brain: it owns the vault, indexes it once, and serves every
; agent — including their writes. That is the shape Pomnia is built around now.
; The desktop authors (distills, holds the passphrase, wires MCP clients) and
; pushes what it makes here with an admin token.
;
; No --read-only, and this is safe rather than reckless: ownership lives in the
; vault itself, at state/vault-writer.json. A vault already claimed by another
; machine keeps this host read-only whatever the flag says, so dropping it
; cannot produce two writers by accident — it only lets this host claim a vault
; that nobody holds.
;
; Two knobs for the other topologies:
;
;   pin as a replica       add  --read-only --vault-owner "Pomnia Desktop"
;                          (--vault-owner is only a label: the name a client
;                          shows when the vault carries no marker yet, seeded
;                          from a tar or from a desktop older than the marker.
;                          Without it clients say "read-only, owner unknown",
;                          which tells nobody where their note should have gone.)
;
;   take a vault over      run once:  brain-core --claim-vault
;                          The previous owner then refuses writes — sync it
;                          before it saves anything else.
ExecStart=/usr/bin/node /opt/pomnia-brain-core/dist/daemon.js \
  --host 0.0.0.0 \
  --port 7865 \
  --data-dir /var/lib/pomnia \
  --vault-root /var/lib/pomnia/vault \
  --skills-root /var/lib/pomnia/vault/skills \
  --instance-label "pomnia-server"

Restart=on-failure
RestartSec=5
; A deterministic crash used to restart every 5s forever, quietly. Give up
; after five tries in a minute so `systemctl status` shows `failed` — a stopped
; service someone notices beats a crash loop nobody does.
StartLimitIntervalSec=60
StartLimitBurst=5
TimeoutStopSec=15

; ── sandbox ────────────────────────────────────────────────────────────────
; The token and account files are created 0600 by the code itself, but the
; search index is not: library.db holds chunks and embeddings in the clear —
; vault content, by design, as Settings says out loud. Under the default umask
; it lands 0644 and every local account can read the memory this product exists
; to protect. ProtectSystem does not help; it governs what the service may
; write, not who may read what it wrote.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
; ^ node JITs; denying W+X kills it outright.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
; ProtectSystem=strict makes everything read-only; these are the exceptions.
; install.sh appends an extra ReadWritePaths= line when --vault-root is outside
; the data dir (e.g. a separate mount for the vault).
ReadWritePaths=/var/lib/pomnia

; ── resource ceilings ──────────────────────────────────────────────────────
; Indexing a large vault is the memory peak. ONNX nomic fp32 alone is ~0.5–1 GB
; resident after load; leave headroom so a leak gets killed instead of the host.
MemoryMax=3G
TasksMax=256
LimitNOFILE=8192

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pomnia-brain-core

[Install]
WantedBy=multi-user.target
