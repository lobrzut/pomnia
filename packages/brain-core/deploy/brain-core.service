[Unit]
Description=Pomnia brain-core — MCP server + RAG over a Pomnia vault
Documentation=https://github.com/lobrzut/pomnia
# Ollama is a hard dependency for search: without an embedder the index cannot
# answer a query. Drop this line if Ollama runs on another host.
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=pomnia
Group=pomnia

# --host 0.0.0.0 turns Bearer auth ON. Tokens live in <data-dir>/mcp-tokens.json
# as [{"name":"…","token":"btk_…","created":"…"}] and are re-read on change, so
# adding or revoking one needs no restart. An absent or unreadable file refuses
# every request — that is deliberate, not a failure mode to work around.
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/pomnia/brain-core/dist/daemon.js \
  --host 0.0.0.0 \
  --port 7862 \
  --data-dir /var/lib/pomnia \
  --vault-root /var/lib/pomnia/vault \
  --skills-root /var/lib/pomnia/vault/skills \
  --ollama-url http://127.0.0.1:11434

Restart=on-failure
RestartSec=5

# Hardening. The service reads a vault and writes one SQLite file; it has no
# business anywhere else on the filesystem.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/pomnia

StandardOutput=journal
StandardError=journal
SyslogIdentifier=brain-core

[Install]
WantedBy=multi-user.target
