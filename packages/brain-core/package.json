{
  "name": "@pomnia/brain-core",
  "version": "0.1.69",
  "private": true,
  "description": "Brain-in-Node: MCP server + RAG for Pomnia desktop and standalone deploy. Successor to the Python brain.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "brain-core": "./dist/daemon.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./vault": "./dist/storage/vault.js",
    "./daemon": "./dist/daemon.js",
    "./embedded": "./dist/embedded.js",
    "./sync": "./dist/sync/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/daemon.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
