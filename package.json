{
  "name": "reliqua",
  "version": "0.1.2",
  "description": "Cross-platform encrypted vault for backing up and restoring AI assistant chat history (Claude Code, Claude Desktop, Cursor, Antigravity, VS Code).",
  "author": "alice",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "./out/main/index.js",
  "bin": {
    "reliqua": "./out/cli/index.js"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "cli": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "build:brain-core": "npm run build -w @reliqua/brain-core",
    "stage:brain-core": "node scripts/stage-brain-core.mjs",
    "pack:win": "npm run build:brain-core && npm run stage:brain-core && electron-vite build && electron-builder --win",
    "pack:mac": "npm run build:brain-core && npm run stage:brain-core && electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "@electron/rebuild": "^3.7.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  }
}
