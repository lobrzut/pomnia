{
  "name": "pomnia",
  "version": "0.1.45",
  "description": "Pomnia — one encrypted memory your AI agents share. Local-first, MCP-native: encrypted vault, distill pipeline, embedded Brain.",
  "homepage": "https://pomnia.ai",
  "author": {
    "name": "Pomnia",
    "url": "https://pomnia.ai"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "./out/main/index.js",
  "bin": {
    "pomnia": "./out/cli/index.js"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "cli": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:golden": "node scripts/golden-path.mjs",
    "build:brain-core": "npm run build --prefix packages/brain-core",
    "build:doc-parser": "npm run build --prefix packages/doc-parser",
    "stage:brain-core": "node scripts/stage-brain-core.mjs",
    "stage:tessdata": "node scripts/stage-tessdata.mjs",
    "pack:win": "npm run build:brain-core && npm run build:doc-parser && npm run stage:brain-core && npm run stage:tessdata && electron-vite build && npm run test:golden && electron-builder --win",
    "pack:mac": "npm run build:brain-core && npm run build:doc-parser && npm run stage:brain-core && npm run stage:tessdata && electron-vite build && npm run test:golden && electron-builder --mac"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@pomnia/brain-core": "*",
    "@pomnia/doc-parser": "*",
    "bluebird": "^3.7.2",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.10.38",
    "sql.js": "^1.12.0",
    "tesseract.js": "^6.0.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "@electron/rebuild": "^3.7.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  }
}
