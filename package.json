{
  "name": "pomnia",
  "version": "0.1.77",
  "description": "Pomnia — one encrypted memory your AI agents share. Local-first, MCP-native: encrypted vault, distill pipeline, embedded Brain.",
  "homepage": "https://pomnia.ai",
  "author": {
    "name": "Pomnia",
    "email": "hello@pomnia.ai",
    "url": "https://pomnia.ai"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "./out/main/index.js",
  "bin": {
    "pomnia": "./out/cli/index.js"
  },
  "scripts": {
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "dev": "npm run generate:build-info && electron-vite dev --watch",
    "build": "npm run generate:build-info && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "cli": "tsx src/cli/index.ts",
    "typecheck": "npm run generate:build-info && npm run typecheck:node && npm run typecheck:web && npm run typecheck:brain-core && npm run typecheck:doc-parser",
    "test": "npm run generate:build-info && vitest run",
    "test:golden": "node scripts/golden-path.mjs",
    "check:release": "node scripts/check-release-complete.mjs",
    "test:e2e:smoke": "node e2e/smoke-first-window.mjs",
    "test:e2e:walkthrough": "node e2e/smoke-walkthrough.mjs",
    "build:brain-core": "npm run build --prefix packages/brain-core",
    "build:doc-parser": "npm run build --prefix packages/doc-parser",
    "stage:brain-core": "node scripts/stage-brain-core.mjs",
    "stage:tessdata": "node scripts/stage-tessdata.mjs",
    "generate:tray": "node scripts/gen-tray-icon.mjs",
    "prune:native-arch": "node scripts/prune-native-arch.mjs",
    "build:win": "npm run build:brain-core && npm run build:doc-parser && npm run stage:brain-core && npm run stage:tessdata && npm run generate:build-info && electron-vite build && npm run test:golden && electron-builder --win",
    "pack:win": "npm run build:win",
    "pack:mac": "npm run build:brain-core && npm run build:doc-parser && npm run stage:brain-core && npm run prune:native-arch && npm run stage:tessdata && npm run generate:build-info && electron-vite build && GOLDEN_PATH_SKIP=1 npm run test:golden && electron-builder --mac --publish never",
    "build:linux": "npm run build:brain-core && npm run build:doc-parser && npm run stage:brain-core && npm run stage:tessdata && npm run generate:build-info && electron-vite build && npm run test:golden && electron-builder --linux --publish never",
    "pack:linux": "npm run build:linux",
    "release:win": "node scripts/release-win.mjs",
    "publish:release": "node scripts/publish-release.mjs",
    "attach:linux-release": "node scripts/attach-linux-release.mjs",
    "attach:win-release": "node scripts/attach-win-release.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "typecheck:brain-core": "npm run typecheck --prefix packages/brain-core",
    "typecheck:doc-parser": "npm run typecheck --prefix packages/doc-parser",
    "dev:mini": "npm run generate:build-info && electron-vite dev --mode mini",
    "web:mini": "vite --config vite.web.config.ts --mode mini"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@pomnia/brain-core": "*",
    "@pomnia/doc-parser": "*",
    "bluebird": "^3.7.2",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.10.38",
    "sql.js": "^1.12.0",
    "tesseract.js": "^6.0.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@tailwindcss/vite": "^4.1.5",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.469.0",
    "playwright-core": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  }
}
