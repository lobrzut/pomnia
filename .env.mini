# Pomnia Desktop Mini — the self-hosted half.
#
# Vault, MCP wiring and replication. No brain-core inside, no Ollama, no
# distiller, no importer: search lives on the server that agents already talk
# to, and a second index on this machine would be a second thing to disagree
# with it.
#
# Read by vite as `import.meta.env.VITE_POMNIA_FLAVOUR`; see src/renderer/src/lib/flavour.ts.
VITE_POMNIA_FLAVOUR=mini

# The main process needs the flavour too, and electron-vite only exposes
# MAIN_VITE_* there. Without it, Mini shares %APPDATA%\pomnia with an installed
# full Desktop — the same settings file, the same vault pointer, two programs
# writing one file. A test build must not be able to damage the thing it is
# being tested against.
MAIN_VITE_POMNIA_FLAVOUR=mini
